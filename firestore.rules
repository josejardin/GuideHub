rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // OTP Verifications collection (Pure 6-Digit Numeric Engine)
    match /otpVerifications/{email} {
      allow read, write: if true;
    }
    
    // Trigger Email collection (Firebase Trigger Email Extension / Cloud Function)
    match /mail/{mailId} {
      allow create: if true;
      allow read: if false;
    }

    // Root users collection
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Role subcollection users: users/{roleCategory}/users/{userId}
    match /users/{roleCategory}/users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Root role collections
    match /students/{userId} {
      allow read, write: if request.auth != null;
    }

    match /counselors/{userId} {
      allow read, write: if request.auth != null;
    }

    match /faculty/{userId} {
      allow read, write: if request.auth != null;
    }

    match /head/{userId} {
      allow read, write: if request.auth != null;
    }

    match /admin/{userId} {
      allow read, write: if request.auth != null;
    }

    // Collection group users support
    match /{path=**}/users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /appointments/{appointmentId} {
      allow create, read, update: if request.auth != null;
    }

    match /referrals/{referralId} {
      allow create, read, update: if request.auth != null;
    }

    match /cases/{caseId} {
      allow read, write: if request.auth != null;
      match /notes/{noteId} {
        allow read, write: if request.auth != null;
      }
    }

    match /walkin_queue/{ticketId} {
      allow read, write: if request.auth != null;
    }

    match /walkinQueue/{ticketId} {
      allow read, write: if request.auth != null;
    }

    match /counselorSchedules/{scheduleId} {
      allow read, write: if request.auth != null;
    }

    match /auditLogs/{logId} {
      allow read, create: if request.auth != null;
    }
  }
}
